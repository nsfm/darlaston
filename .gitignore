# ToupTek SDK: ships with no licence or copyright notice, so it is
# never vendored. Users install it themselves; we dlopen at runtime.
sdk/
toupcamsdk*
lib*.so
*.so.*

# Captures, calibration data and scratch — large, and not source
spike/
captures/
sessions/
profiles/
calibration/
*.tif
*.tiff
*.dng
*.fits
*.fit
*.raw
*.png
*.jpg
*.xmp

# The mark, which is source rather than output. The blanket *.png above
# is for photographs, and it swallowed this one silently -- the AppImage
# build referenced a file that existed on one laptop and in no clone.
!packaging/icons/*.png

# README art, for the same reason and with a worse failure: an asset
# that is not committed renders as a broken image for every reader.
!assets/*.png

# Site art, same reason again: brand assets are source, not photographs.
!site/public/*.png
!site/public/*.jpg

# The site's dependencies. Its build output is already covered by dist/.
site/node_modules/

# Written by setuptools-scm at build time, from the git tags.
darlaston/_version.py

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Bundled fonts are deliberate (IBM Plex, OFL 1.1)
!photomicrography/ui/fonts/
