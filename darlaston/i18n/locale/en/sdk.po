# Installing a camera vendor's SDK from inside the application. The screen
# a first-time user actually hits, so it says what will be downloaded and
# from where before anything happens.

msgid "sdk.title"
msgstr "Install camera SDK"

msgid "sdk.heading"
msgstr ""
"Your camera needs a driver. Pick your camera's brand and <i>darlaston</i> will "
"download it for you."

msgid "sdk.brand.label"
msgstr "Camera brand"

#. One brand in the picker, when we have no verified direct link for it.
#. {label} is the brand's own name and is never translated.
msgid "sdk.brand.option.manual"
msgstr "{label}  (manual download)"

msgid "sdk.action.download"
msgstr "Download and install"

msgid "sdk.action.page"
msgstr "Open download page"

msgid "sdk.action.done"
msgstr "Done"

#. The bold is layout and has to survive translation.
msgid "sdk.detail.already"
msgstr "<b>Already installed.</b> Downloading again will replace it."

#. What the download will cost and where it lands. {size} is megabytes,
#. {host} the site it comes from, {where} the directory it is unpacked into.
#. The markup is layout: <code> sets the path apart from the sentence.
msgid "sdk.detail.automatic"
msgstr ""
"About <b>{size} MB</b>, downloaded from {host} and saved in "
"<code>{where}</code>."

#. A brand with no verified direct link. {label} is the brand's own name,
#. {page} the address of their download page, {where} the directory the
#. archive has to be unzipped into. The link markup has to survive.
msgid "sdk.detail.manual"
msgstr ""
"{label} does not offer a direct download link. Get the driver from "
"<a href='{page}'>their website</a>, then unzip it into <code>{where}</code>."

#. {where} is the directory, which has already been created by the time this
#. is shown.
msgid "sdk.status.opened"
msgstr ""
"Opened their website. Please unzip the driver into {where}."

#. {host} is the site the archive comes from.
msgid "sdk.status.contacting"
msgstr "Contacting {host}…"

#. The download failed TLS verification. Nearly always a Python with no
#. certificate store rather than a vendor problem, and the browser
#. route always works because browsers carry their own trust. The
#. dialog has just opened the maker's page and the destination folder,
#. which is why the message may speak of them without naming a path.
msgid "sdk.status.tls"
msgstr ""
"The secure download could not be verified on this computer, so the "
"manual route is ready instead: your browser has the camera maker's "
"download page, and the folder darlaston reads from just opened. Unzip "
"the downloaded SDK into that folder, then restart darlaston."

msgid "sdk.status.installed"
msgstr ""
"Installed. Unplug the camera, plug it back in, and <i>darlaston</i> will find "
"it."

#. The download bar. `%p%` is Qt's own placeholder for the percentage and
#. must be left exactly as it is. {done} and {total} are megabytes, already
#. rounded.
msgid "sdk.progress.detail"
msgstr "%p%  ({done} of {total} MB)"

#. The server sent no length, so there is no percentage to show, only how
#. much has arrived.
msgid "sdk.progress.detail.unsized"
msgstr "{done} MB"
