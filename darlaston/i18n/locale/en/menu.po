# The menu bar. One axis: before a session, during it, or after it.
#
# The three menu names are labels only. Each menu is registered under a
# separate identifier, so translating these cannot break the lookup.

msgid "app.title"
msgstr "darlaston"

msgid "menu.setup"
msgstr "Setup"

msgid "menu.capture"
msgstr "Capture"

msgid "menu.darkroom"
msgstr "Darkroom"

#. Setup: what outlives the session.
msgid "menu.setup.microscopes"
msgstr "Microscopes…"

msgid "menu.setup.cameras"
msgstr "Cameras…"

msgid "menu.setup.photographer"
msgstr "Photographer…"

msgid "menu.setup.files"
msgstr "Files…"

msgid "menu.setup.performance"
msgstr "Performance…"

#. A checkbox. Ticked, this program draws its own title bar and window
#. buttons; cleared, the desktop draws them in its own style.
msgid "menu.setup.chrome"
msgstr "Styled window frame"

msgid "menu.setup.install_sdk"
msgstr "Install camera SDK…"

msgid "menu.setup.install_thumbnailer"
msgstr "Install DNG thumbnailer…"

#. Capture: what needs a camera.
msgid "menu.capture.timelapse"
msgstr "Timelapse…"

msgid "menu.capture.guides"
msgstr "Framing guides"

msgid "menu.capture.guides.none"
msgstr "None"

msgid "menu.capture.guides.thirds"
msgstr "Rule of thirds"

msgid "menu.capture.guides.grid"
msgstr "Fine grid"

msgid "menu.capture.guides.cross"
msgstr "Center cross"

msgid "menu.capture.guides.cross.tooltip"
msgstr ""
"Independent of the grid: centering a specimen and composing a frame are "
"different jobs."

msgid "menu.capture.white_balance"
msgstr "Write white balance"

msgid "menu.capture.white_balance.tooltip"
msgstr ""
"Off writes a neutral file: the sensor's own channels, untouched.\n"
"Use for polarized interference color, fluorescence or stained\n"
"sections, where no part of the field is neutral by nature."

msgid "menu.capture.calibration"
msgstr "Calibration"

msgid "menu.capture.slide_map"
msgstr "Slide map"

msgid "menu.capture.performance"
msgstr "Performance monitor"

msgid "menu.capture.performance.tooltip"
msgstr ""
"What each feature costs per frame, so the expensive ones can be found "
"rather than guessed at."

#. Darkroom: acts on files already on disk, never touches the camera.
msgid "menu.darkroom.stitch"
msgstr "Stitch mosaic…"

msgid "menu.darkroom.flythrough"
msgstr "Fly through a mosaic…"

msgid "menu.darkroom.depth"
msgstr "Render from depth…"

msgid "menu.darkroom.plate"
msgstr "Make a plate…"

msgid "menu.darkroom.arrange"
msgstr "Arrange specimens…"

#. Present: the session again, facing the audience. A second window that
#. mirrors the live view for a screen other people watch.
msgid "menu.present"
msgstr "Present"

msgid "menu.present.window"
msgstr "Presentation window"

msgid "menu.present.window.tooltip"
msgstr ""
"A second window that shows only the picture.\n"
"Drag it to a screen the audience can see, and double click it to fill "
"the screen."

#. The overlays. Each answers something a visitor at an event asks.
msgid "menu.present.scale_bar"
msgstr "Scale bar"

msgid "menu.present.scale_bar.tooltip"
msgstr ""
"Draw the scale bar on the presentation, in the style chosen under "
"Capture.\n"
"It answers the first question every audience asks: how big is that?"

msgid "menu.present.magnification"
msgstr "Magnification"

msgid "menu.present.magnification.tooltip"
msgstr "Show the magnification in the corner of the presentation."

msgid "menu.present.subject"
msgstr "Slide subject"

msgid "menu.present.subject.tooltip"
msgstr "Show what is on the slide, as typed in the subject boxes."

msgid "menu.present.live"
msgstr "Live marker"

msgid "menu.present.live.tooltip"
msgstr ""
"Mark the picture as happening right now.\n"
"It goes out by itself if the feed stops, so it never marks a frozen "
"frame as live."

msgid "menu.present.header"
msgstr "Header"

msgid "menu.present.header.tooltip"
msgstr ""
"Show your own two lines in the top corner.\n"
"A society name and its website, or a note about the exhibit."

msgid "menu.present.header_text"
msgstr "Set the header…"

#. Holding is a moment, not a preference: it freezes the audience's
#. picture while a slide is swapped. Space on the window does the same.
msgid "menu.present.hold"
msgstr "Hold the picture"

msgid "menu.present.hold.tooltip"
msgstr ""
"Freeze the presentation on the current field while you change slides.\n"
"Space on the presentation window does the same thing."

msgid "menu.present.fill"
msgstr "Crop to fill"

msgid "menu.present.fill.tooltip"
msgstr ""
"Let the picture fill the whole screen, cropping the frame's edges,\n"
"instead of keeping every pixel and living with black bars."

msgid "menu.present.captions.size"
msgstr "Caption size"

msgid "menu.present.captions.small"
msgstr "Small"

msgid "menu.present.captions.normal"
msgstr "Normal"

msgid "menu.present.captions.large"
msgstr "Large"

msgid "menu.present.captions.opacity"
msgstr "Caption opacity"

msgid "menu.present.captions.solid"
msgstr "Solid"

msgid "menu.present.captions.soft"
msgstr "Soft"

msgid "menu.present.captions.faint"
msgstr "Faint"

msgid "menu.present.screen"
msgstr "Screen size…"

msgid "menu.present.screen.tooltip"
msgstr ""
"Tell the window how wide the audience's picture really is,\n"
"and it can say how large things appear on that screen."

#. A network service, so it is off at every launch and the address is
#. announced when it starts.
msgid "menu.present.stream"
msgstr "Stream to the network"

msgid "menu.present.stream.tooltip"
msgstr ""
"Stream the presentation live on your local network.\n"
"OBS reads it as a browser or media source, and any browser on the "
"network can simply open the address."

msgid "menu.present.stream_clean"
msgstr "Hide overlays from the stream"

msgid "menu.present.stream_clean.tooltip"
msgstr ""
"Send the bare picture, for building your own titles in OBS.\n"
"The presentation window keeps its captions either way."

#. A toggle and a window, the same shape as white balance above it. In
#. Capture rather than in Files, because Files is about where photographs
#. go and this is about what is on them.
msgid "menu.capture.scale_bar"
msgstr "Scale bar"

msgid "menu.capture.scale_bar.tooltip"
msgstr ""
"Draw a labeled bar on the photograph.\n"
"Never on the raw, and never unless the scale is known."

msgid "menu.capture.scale_bar.style"
msgstr "Scale bar…"

#. Shows the bar over the live view too, using the same settings the
#. photograph will get. Nothing is written to any file by this.
msgid "menu.capture.scale_bar.live"
msgstr "Scale bar on the live view"

msgid "menu.capture.scale_bar.live.tooltip"
msgstr ""
"Draws the bar over the preview, exactly as the photograph will carry it.\n"
"Nothing is written to a file, and the raw is untouched either way."
