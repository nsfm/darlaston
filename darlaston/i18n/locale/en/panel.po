# Floating panels: the slide map, the stack window, the performance monitor.

#: The grab corner. Qt's own size grip only resizes top-level windows, so
#: these panels draw their own.
msgid "panel.resize.tooltip"
msgstr "Drag to resize"

#. Shown on a control the camera does not have. Not a fault: cameras
#. that expose nothing at all are real, and on a microscope the
#. illumination is the right thing to adjust anyway.
msgid "rail.no_exposure"
msgstr ""
"This camera does not let darlaston set the exposure.\n"
"Set the brightness on the microscope instead: the lamp, and the field "
"and condenser diaphragms."

msgid "rail.no_gain"
msgstr "This camera does not let darlaston set the gain."
