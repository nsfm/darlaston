# How the program looks and where things sit. Setup > Appearance.

msgid "appearance.title"
msgstr "Appearance"

#. ---- the rail of panels -------------------------------------------------

msgid "appearance.sidebar.heading"
msgstr "Sidebar"

msgid "appearance.sidebar.left"
msgstr "Left"

msgid "appearance.sidebar.right"
msgstr "Right"

msgid "appearance.sidebar.note"
msgstr "The rail of panels beside the picture. Applies at once."

#. ---- the window frame ---------------------------------------------------

msgid "appearance.frame.heading"
msgstr "Window frame"

#. Was a lone entry in the Setup menu, "Styled window frame".
msgid "appearance.frame.label"
msgstr "Styled window frame"

msgid "appearance.frame.note"
msgstr ""
"Draw our own title bar instead of the desktop's. Where the desktop draws a "
"good one this is a matter of taste; where it draws a poor one or none, it is "
"the difference between looking finished and not."

#. ---- the palette --------------------------------------------------------
#. Each is named for something seen down the tube. The names are proper
#. nouns and stay as they are in every language.

msgid "appearance.palette.heading"
msgstr "Palette"

msgid "appearance.palette.pseudoscorpion"
msgstr "Pseudoscorpion"

msgid "appearance.palette.blepharisma"
msgstr "Blepharisma"

msgid "appearance.palette.stentor"
msgstr "Stentor"

msgid "appearance.palette.diatom"
msgstr "Diatom"

msgid "appearance.palette.note"
msgstr ""
"Grey-green and brass; pink on wine; blue-green, high contrast; glass on "
"black, high contrast. Every one is dark: this is used in a dark room beside "
"a bright eyepiece. Open windows pick it up when reopened."
