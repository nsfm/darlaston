# darlaston, English.
#
# This is the source catalogue: the keys are written against it and it is
# always loaded, because a symbolic key has no readable fallback. Editing
# the English here is safe and invalidates nothing -- that is the whole
# reason the identifiers are keys rather than sentences.
#
# Keys read area.thing.role:
#   area   where in the program it appears -- setup, calib, capture, error
#   thing  the control or concept it belongs to
#   role   what it is -- label, tooltip, action, detail, placeholder, step
#
msgid ""
msgstr ""
"Project-Id-Version: darlaston\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. The rail row that summarises calibration and opens the panel.
msgid "calib.button.label"
msgstr "calibration"

msgid "calib.button.working"
msgstr "calibration   working…"

msgid "calib.button.complete"
msgstr "calibration   complete"

#. {have} of {total} products exist. A count rather than a list: the rail
#. is 258 px wide and a truncated list looks like information and is not.
msgid "calib.button.progress"
msgstr "calibration   {have} of {total}"

msgid "calib.button.tooltip"
msgstr ""
"Dark, flat, white balance and preview profile for this configuration.\n"
"Click to open. Missing products are a nag, not a gate. Capture anyway\n"
"and the file records what it did and did not have."

#. The dark frame.
msgid "calib.dark.label"
msgstr "dark"

msgid "calib.dark.action"
msgstr "Shoot"

msgid "calib.dark.tooltip"
msgstr ""
"Cap the lens or switch the lamp off, then shoot.\n"
"Averaged over several frames; ages after about eight hours because this "
"sensor has no cooling."

#. The flat field. One row with three jobs, so three actions.
msgid "calib.flat.label"
msgstr "flat"

msgid "calib.flat.action.collect"
msgstr "Collect"

msgid "calib.flat.action.stop"
msgstr "Stop"

msgid "calib.flat.action.build"
msgstr "Build"

msgid "calib.flat.tooltip"
msgstr ""
"Set the light and the optics the way you will shoot, then collect.\n"
"Move to blank glass and hold still; four frames at distinct stage\n"
"positions median away slide debris. Each one freezes the preview for\n"
"about a second, and a flat is only valid at the illumination it\n"
"was shot under."

#. {banked} of {wanted} blank fields gathered so far.
msgid "calib.flat.detail.count"
msgstr "{banked}/{wanted}"

msgid "calib.flat.detail.collecting"
msgstr "{banked}/{wanted}  move to blank glass"

#. Fewer than three will not median away debris on the glass.
msgid "calib.flat.detail.debris"
msgstr "{banked}/{wanted}  3+ rejects debris"

#. White balance, which is derived rather than shot.
msgid "calib.wb.label"
msgstr "white balance"

msgid "calib.wb.action"
msgstr "--"

msgid "calib.wb.detail"
msgstr "from flat"

msgid "calib.wb.tooltip"
msgstr ""
"Measured from the flat. A featureless illuminated field is neutral by "
"definition."

#. The preview profile: what the ISP does to the sensor data.
msgid "calib.lut.label"
msgstr "preview profile"

msgid "calib.lut.action"
msgstr "Profile"

msgid "calib.lut.tooltip"
msgstr ""
"Measures what the ISP does to the sensor data, so the histogram can "
"report real headroom.\nTakes an exposure ramp, so it needs a few seconds."

#. ---- camera errors ------------------------------------------------------
#. Every message here says what to do, not merely what broke. These are the
#. words a person reads at midnight with a diatom under the objective.

#. Heading and detail joined, when a failure reaches a traceback.
msgid "error.joined"
msgstr "{heading}: {detail}"

#. An SDK error code, with the code kept verbatim for bug reports.
msgid "error.code.with_code"
msgstr "{advice}  [{name} {code}]"

msgid "error.code.unknown"
msgstr "The camera reported an error."

msgid "error.code.e_unexpected"
msgstr ""
"The camera refused a setting while it was running. This is a bug in "
"darlaston's mode handling. Please report it."

msgid "error.code.e_notimpl"
msgstr "This camera model does not support that feature."

msgid "error.code.e_accessdenied"
msgstr ""
"No permission to open the camera. Install the SDK's udev rules file, then "
"unplug and replug the camera."

msgid "error.code.e_outofmemory"
msgstr "The system is out of memory."

msgid "error.code.e_invalidarg"
msgstr ""
"The camera rejected an argument. This is a bug in darlaston. Please report "
"it."

msgid "error.code.e_pointer"
msgstr ""
"The camera was handed a null pointer. This is a bug in darlaston. Please "
"report it."

msgid "error.code.e_fail"
msgstr "The camera reported a generic failure."

msgid "error.code.e_wrong_thread"
msgstr ""
"The camera was called from the wrong thread. This is a bug in darlaston. "
"Please report it."

msgid "error.code.e_gen_failure"
msgstr ""
"The camera stopped responding. This is almost always physical: try a "
"different USB 3 port, reseat the cable, or avoid a hub. The link can also "
"drop under a long session."

msgid "error.code.e_busy"
msgstr ""
"The camera is already in use. Another copy of darlaston or ToupLite may "
"have it open."

msgid "error.code.e_pending"
msgstr "The camera has no data ready yet."

msgid "error.code.e_timeout"
msgstr ""
"The camera did not deliver the frame in time. If the exposure is long this "
"may just need more patience; if it repeats, the link may have dropped to "
"USB 2.0, usually the cable."

msgid "error.code.e_unreach"
msgstr "The camera is unreachable over the network."

msgid "error.code.e_cancelled"
msgstr "The operation was cancelled."

#. No vendor SDK installed at all.
msgid "error.sdk_missing.heading"
msgstr "No camera SDK installed"

msgid "error.sdk_missing.detail"
msgstr ""
"Your camera needs a driver made by the company that built it. This only "
"has to be done once."

#. Must match the button on the waiting page.
msgid "error.sdk_missing.step.install"
msgstr ""
"Click Install the camera driver below. darlaston will download it and "
"check that it works."

msgid "error.sdk_missing.step.manual"
msgstr ""
"Or download it yourself from your camera maker's website and unzip it into "
"~/toup/."

msgid "error.sdk_missing.step.usb"
msgstr ""
"If you have an ordinary USB microscope camera instead, start darlaston "
"with --usb. Those need no driver, but they cannot produce raw files."

#. A library is installed but predates functions darlaston needs.
msgid "error.sdk_old.heading"
msgstr "The installed camera SDK is too old"

#. {path} is where it was found, {missing} the functions it lacks.
msgid "error.sdk_old.detail"
msgstr ""
"{path} is missing {missing}. ToupLite bundles a library from 2021 under "
"exactly the same filename as a current SDK, so having both installed is "
"easy to do by accident."

msgid "error.sdk_old.step.download"
msgstr "Download a current SDK from your camera's manufacturer."

msgid "error.sdk_old.step.point"
msgstr "Set TOUPCAM_SDK to point at it, so the old copy is not found first."

msgid "error.sdk_old.step.restart"
msgstr "Restart darlaston."

#. Nothing answered on the bus. {what} is usually "camera".
msgid "error.no_camera.heading"
msgstr "No {what} found"

msgid "error.no_camera.detail"
msgstr "The software is working, but nothing answered on the bus."

msgid "error.no_camera.step.plugged"
msgstr "Check that the camera is plugged in."

msgid "error.no_camera.step.cable"
msgstr ""
"Try a different USB port, and a different cable. A marginal cable does not "
"fail cleanly, it renegotiates to USB 2.0 and everything simply becomes slow."

msgid "error.no_camera.step.wait"
msgstr "Some cameras take a few seconds after being plugged in."

#. Something else already owns the device.
msgid "error.busy.heading"
msgstr "Another program is using the camera"

msgid "error.busy.detail"
msgstr "The device opened, but something else holds it."

msgid "error.busy.step.close"
msgstr "Close ToupLite, ToupView, AmScope, or any other capture program."

msgid "error.busy.step.video_call"
msgstr "On a laptop, a video-call application may have claimed it."

msgid "error.busy.step.wait"
msgstr "darlaston will connect on its own once the camera is free."

#. On the bus, but not openable by this user.
msgid "error.permission.heading"
msgstr "No permission to open the camera"

msgid "error.permission.detail"
msgstr ""
"The camera is on the bus but this user cannot open it. Cameras need a udev "
"rule to be usable without root."

msgid "error.permission.step.rules"
msgstr ""
"Copy the SDK's udev rules file (99-toupcam.rules or your brand's "
"equivalent) into /etc/udev/rules.d/."

msgid "error.permission.step.reload"
msgstr "Run: sudo udevadm control --reload-rules"

msgid "error.permission.step.replug"
msgstr "Unplug the camera and plug it back in."
